{
  "expo": {
    "name": "Finance App",
    "slug": "finance-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "finance-app",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.finance-app.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/skinO.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/skinO-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.finance-app.app"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-font"],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c4a7ea94-fb77-4aa4-8d7d-0eec34b81720"
      }
    }
  }
}
